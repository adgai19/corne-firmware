#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <zmk-helpers/helper.h>
#include <zmk-helpers/key-labels/42.h>

#define BASE  0
#define NAV   1
#define SYM   2
#define NUM   3
#define MEDIA 4
#define BLE   5

/* Home-row mods */

ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    hold-trigger-key-positions = <6 7 8 9 10 11 39 40 41>;
    hold-trigger-on-release;
    bindings = <&kp>, <&kp>;
)

ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    hold-trigger-key-positions = <0 1 2 3 4 5 36 37 38>;
    hold-trigger-on-release;
    bindings = <&kp>, <&kp>;
)

/* Navigation */
ZMK_COMBO(home_combo,       &kp HOME,        RM1 RM2,    ALL)
ZMK_COMBO(end_combo,        &kp END,         RM2 RM3,    ALL)
ZMK_COMBO(pgup_combo,       &kp PG_UP,       RT1 RT2,    ALL)
ZMK_COMBO(pgdn_combo,       &kp PG_DN,       RT2 RT3,    ALL)

/* Editing */
ZMK_COMBO(delete_word,      &kp LA(BSPC),    LB2 LB3,    ALL)
ZMK_COMBO(esc_combo,        &kp ESC,         LM0 LM1,    ALL)
ZMK_COMBO(tab_combo,        &kp TAB,         RM0 RM1,    ALL)

/* Brackets */
ZMK_COMBO(paren_l,          &kp LPAR,        LT2 LT3,    ALL)
ZMK_COMBO(paren_r,          &kp RPAR,        LT3 LT4,    ALL)
ZMK_COMBO(brace_l,          &kp LBRC,        LB1 LB2,    ALL)
ZMK_COMBO(brace_r,          &kp RBRC,        LT4 LT5,    ALL)
ZMK_COMBO(bracket_l,        &kp LBKT,        LM2 LM3,    ALL)
ZMK_COMBO(bracket_r,        &kp RBKT,        LM3 LM4,    ALL)

/* App / window switching */
ZMK_COMBO(raycast,          &kp LG(SPACE),   LT3 RT3,    ALL)
ZMK_COMBO(app_switch,       &kp LA(TAB),     LT1 LT2,    ALL)
ZMK_COMBO(window_switch,    &kp LA(GRAVE),   RT4 RT5,    ALL)

/* Tab navigation */
ZMK_COMBO(ctrl_shift_tab,   &kp LC(LS(TAB)), LT0 LT1,    ALL)
ZMK_COMBO(ctrl_tab,         &kp LC(TAB),     LT2 LT1,    ALL)

/* Misc */
ZMK_COMBO(tmux_prefix,      &kp LC(T),       LB0 LB1,    ALL)

/ {

keymap {
  compatible = "zmk,keymap";

  BASE {
    bindings = <
&none         &kp Q        &kp W        &kp F        &kp P        &kp B                              &kp J        &kp L        &kp U        &kp Y        &kp SEMI     &none
&none         &hml LSHFT A &hml LCTRL R &hml LALT S  &hml LGUI T  &kp G                              &kp M        &hmr RGUI N  &hmr RALT E  &hmr RCTRL I &hmr RSHFT O &none
&none         &kp Z        &kp X        &kp C        &kp D        &kp V      &kp C_MUTE   &none       &kp K        &kp H        &kp COMMA    &kp DOT      &kp FSLH     &none
                                        &lt NAV ESC  &kp SPACE    &mo MEDIA                           &lt BLE LA(SPACE) &lt SYM RET  &lt NUM BSPC
    >;

    sensor-bindings = <
      &inc_dec_kp C_VOL_UP C_VOL_DN
      &inc_dec_kp PG_UP PG_DN
    >;
  };

  NAV {
    bindings = <
&trans &trans   &trans   &trans   &trans   &trans                       &trans    &kp HOME  &kp PG_DN &kp PG_UP &kp END   &trans
&trans &trans   &trans   &trans   &trans   &trans                       &trans    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans
&trans &trans   &trans   &trans   &trans   &trans   &trans   &trans     &trans    &kp DEL   &kp TAB   &kp ESC   &trans    &trans
                         &trans   &trans   &trans                       &trans    &trans    &trans
    >;
  };

  SYM {
    bindings = <
&trans &trans    &trans    &trans    &trans    &trans                       &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &trans
&trans &trans    &trans    &trans    &trans    &trans                       &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH  &trans
&trans &trans    &trans    &trans    &trans    &trans   &trans   &trans     &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &trans
                           &trans    &trans    &trans                       &trans    &trans    &trans
    >;
  };

  NUM {
    bindings = <
&trans &trans    &trans    &trans    &trans    &trans                       &kp LBKT  &kp N7    &kp N8    &kp N9    &kp RBKT  &trans
&trans &kp PLUS  &kp MINUS &kp STAR  &kp SLASH &trans                       &kp SEMI  &kp N4    &kp N5    &kp N6    &kp EQUAL &trans
&trans &trans    &trans    &trans    &trans    &trans   &trans   &trans     &kp GRAVE &kp N1    &kp N2    &kp N3    &kp BSLH  &trans
                           &trans    &trans    &trans                       &trans    &kp DOT   &kp N0
    >;
  };

  MEDIA {
    bindings = <
&trans &trans &trans &trans &trans &trans                       &trans       &trans       &trans       &trans       &trans &trans
&trans &trans &trans &trans &trans &trans                       &kp C_PREV   &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT   &trans &trans
&trans &trans &trans &trans &trans &trans   &trans   &trans     &trans       &kp C_MUTE   &trans       &trans       &trans &trans
                     &trans &trans &trans                       &trans       &kp C_PP     &trans
    >;

    sensor-bindings = <
      &inc_dec_kp C_VOL_UP C_VOL_DN
      &inc_dec_kp C_NEXT C_PREV
    >;
  };

  BLE {
    bindings = <
&trans &trans       &trans       &trans       &trans       &trans                       &trans &trans       &trans       &trans       &trans       &trans
&trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4               &trans &trans       &trans       &trans       &trans       &trans
&trans &trans       &trans       &trans       &trans       &bt BT_CLR &trans   &trans   &trans &trans       &trans       &trans       &trans       &trans
                                 &trans       &trans       &bootloader                  &trans &sys_reset   &trans
    >;
  };

};

};
