#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <zmk-helpers/helper.h>
#include <zmk-helpers/key-labels/42.h>


ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    hold-trigger-key-positions = <6 7 8 9 10 11 39 40 41>;
    hold-trigger-on-release;
    bindings = <&kp>, <&kp>;
)

ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    hold-trigger-key-positions = <0 1 2 3 4 5 36 37 38>;
    hold-trigger-on-release;
    bindings = <&kp>, <&kp>;
)

/* Navigation */
ZMK_COMBO(home_combo,       &kp HOME,        RM1 RM2,    ALL)
ZMK_COMBO(end_combo,        &kp END,         RM2 RM3,    ALL)
ZMK_COMBO(pgup_combo,       &kp PG_UP,       RT1 RT2,    ALL)
ZMK_COMBO(pgdn_combo,       &kp PG_DN,       RT2 RT3,    ALL)

/* Editing */
ZMK_COMBO(delete_word,      &kp LA(BSPC),    LB2 LB3,    ALL)
ZMK_COMBO(esc_combo,        &kp ESC,         LM0 LM1,    ALL)
ZMK_COMBO(tab_combo,        &kp TAB,         RM0 RM1,    ALL)

/* Brackets */
ZMK_COMBO(paren_l,          &kp LPAR,        LT2 LT3,    ALL)
ZMK_COMBO(paren_r,          &kp RPAR,        LT3 LT4,    ALL)
ZMK_COMBO(brace_l,          &kp LBRC,        LB1 LB2,    ALL)
ZMK_COMBO(brace_r,          &kp RBRC,        LT4 LT5,    ALL)
ZMK_COMBO(bracket_l,        &kp LBKT,        LM2 LM3,    ALL)
ZMK_COMBO(bracket_r,        &kp RBKT,        LM3 LM4,    ALL)

/* App / window switching */
ZMK_COMBO(raycast,          &kp LG(SPACE),   LT3 RT3,    ALL)
ZMK_COMBO(app_switch,       &kp LA(TAB),     LT1 LT2,    ALL)
ZMK_COMBO(window_switch,    &kp LA(GRAVE),   RT4 RT5,    ALL)

/* Tab navigation */
ZMK_COMBO(ctrl_shift_tab,   &kp LC(LS(TAB)), LT0 LT1,    ALL)
ZMK_COMBO(ctrl_tab,         &kp LC(TAB),     LT2 LT1,    ALL)

/* Misc */
ZMK_COMBO(tmux_prefix,      &kp LC(T),       LB0 LB1,    ALL)
ZMK_COMBO(opt_space,        &kp LA(SPACE),   LM4 RM4,    ALL)

/ {

keymap {
  compatible = "zmk,keymap";

  default_layer {
    bindings = <
&kp TAB       &kp Q        &kp W        &kp F        &kp P        &kp B                          &kp J        &kp L        &kp U        &kp Y        &kp SEMI       &kp MINUS
&kp ESC       &hml LSHFT A &hml LCTRL R &hml LALT S  &hml LGUI T  &kp G                          &kp M        &hmr RGUI N  &hmr RALT E  &hmr RCTRL I  &hmr RSHFT O   &kp SQT
&kp LSHFT     &kp Z        &kp X        &kp C        &kp D        &kp V      &kp C_MUTE &none     &kp K        &kp H        &kp COMMA    &kp DOT      &kp FSLH       &kp RSFT
                                 &mo 2           &mt LCTRL TAB   &mt LGUI SPACE                 &mt LSHIFT RET  &mt LALT BSPC   &mo 1
    >;

    sensor-bindings = <
      &inc_dec_kp C_VOL_UP C_VOL_DN
      &inc_dec_kp PG_UP PG_DN
    >;
  };

  LOWER {
    bindings = <
&trans &trans &trans &trans &trans &trans         &kp HOME  &kp PG_DN &kp PG_UP &kp END  &trans &trans
&trans &trans &trans &trans &trans &trans         &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                         &trans &trans &trans                  &trans &trans &trans
    >;
  };

  HIGHER {
    bindings = <
&trans &trans &trans &trans &trans &trans         &kp EXCL &kp AT    &kp HASH &kp DLLR &kp PRCNT &kp CARET
&trans &trans &trans &trans &trans &trans         &kp PLUS &kp MINUS &kp STAR &kp SLASH &kp EQUAL &kp BSLH
&trans &trans &trans &trans &trans &trans &trans &trans    &kp N7 &kp N8 &kp N9 &kp COLON &kp SEMI &trans
                         &trans &trans &trans                  &trans &kp N0 &trans
    >;
  };

  TRI {
    bindings = <
&trans &trans &trans &trans &trans &trans         &kp C_VOL_UP &kp C_MUTE &kp C_VOL_DN &trans &trans &trans
&trans &trans &trans &trans &trans &trans         &kp LEFT   &kp DOWN &kp UP     &kp RIGHT &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans     &trans &trans &trans &trans &trans &trans
                         &trans &trans &trans                  &trans &trans &trans
    >;
  };

};

};
